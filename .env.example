# Chronolith configuration — copy this file to `.env` and fill in your values.

# The bot token from https://discord.com/developers/applications
BOT_TOKEN=

# Optional: override the default database type used by ForgeDB.
# One of: better-sqlite3, sqlite, mysql, postgres, mongodb
# DB_TYPE=better-sqlite3

# Optional: database connection URI when using mysql/postgres/mongodb.
# DB_URI=
